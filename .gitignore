/target
.superpowers/
.build_number
.env

# Local reference data, never committed.
geojsons/

# PMTiles archives for the offline example. Even a city is tens of
# megabytes and every user wants a different region, so these are
# obtained rather than committed -- see docs/OFFLINE.md.
*.pmtiles
*.mbtiles

# The import-coverage document the coverage overlay reads. GENERATED by an
# offline ETL, and stale the moment another region is imported, so it is regenerated rather than committed. See
# `src/render/coverage.rs`.
/work/

# Public open data the `demos/` fetch scripts download or convert (US Census
# TIGER/Line and the like). Obtained, never committed -- gigabytes, and every
# script can recreate it. See demos/README.md.
demos/data/**/*.zip
demos/data/**/*.shp
demos/data/**/*.shx
demos/data/**/*.dbf
demos/data/**/*.prj
demos/data/**/*.cpg
demos/data/**/*.xml
demos/data/**/*.geojson
demos/data/**/*.geojsonl
demos/data/**/*.json
demos/data/cache/
tools/dotgrid-build/target/
tools/census-pack/target/

# The embeddable iOS engine: build output of scripts/build-ios-embed.sh and
# the sample's xcodegen project. Regenerated, never committed.
/embed-ios/dist/
/embed-ios/sample/GpuiMapsSample.xcodeproj/
/embed-ios/sample/Generated/
/embed-ios/sample/build/

# Release builds (scripts/bundle-studio.sh, notarize.sh): .app, zip, DMG.
/dist/

# macOS Finder metadata.
.DS_Store
