{
  "version": 8,
  "name": "Protomaps Basemap (v3 schema), light",
  "metadata": {
    "gpui-maps:why": "Hand-authored against the layer and pmap:kind vocabulary actually present in the archive examples/pmtiles_remote.rs defaults to, read out of a decoded z12/z14/z15 tile rather than copied from a theme generator. The vendored Liberty and Mapbox styles next to this file are OpenMapTiles/Mapbox schema and match none of these source-layer names, which is why a Protomaps archive drawn with one of them renders an empty page.",
    "gpui-maps:schema": "Protomaps basemap v3 (metadata `version` 3.7.1). Field names carry the `pmap:` prefix; v4 archives drop it, so a v4 URL needs a v4 style."
  },
  "sources": {
    "protomaps": { "type": "vector" }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#cdd2d4" }
    },
    {
      "id": "earth",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "earth",
      "paint": { "fill-color": "#f6f4f0" }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landuse",
      "paint": {
        "fill-color": [
          "match",
          ["get", "pmap:kind"],
          ["park", "garden", "dog_park", "recreation_ground", "golf_course", "protected_area", "village_green"],
          "#d6e6c8",
          ["pitch", "playground"],
          "#cbe2b7",
          ["farmland", "greenfield", "allotments", "orchard", "farmyard"],
          "#eeecd8",
          ["cemetery"],
          "#dde3d4",
          ["hospital", "school", "university", "college", "kindergarten"],
          "#efe6e2",
          ["industrial", "commercial", "railway", "military"],
          "#eae5e0",
          ["pedestrian"],
          "#efece6",
          "#f1eee9"
        ]
      }
    },
    {
      "id": "natural",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "natural",
      "paint": {
        "fill-color": [
          "match",
          ["get", "pmap:kind"],
          ["wood", "forest"],
          "#cfe0bd",
          ["grass", "meadow", "scrub", "heath"],
          "#dcebc8",
          ["sand", "beach"],
          "#f3ead0",
          ["glacier"],
          "#eef4f7",
          "#dcebc8"
        ]
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "water",
      "paint": { "fill-color": "#a3c1de" }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "protomaps",
      "source-layer": "physical_line",
      "filter": ["in", "pmap:kind", "river", "stream", "canal", "ditch", "drain"],
      "paint": {
        "line-color": "#a3c1de",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          9, 0.4,
          13, 1.2,
          15, 2.5
        ]
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "buildings",
      "minzoom": 13,
      "paint": { "fill-color": "#e3ded6" }
    },
    {
      "id": "transit",
      "type": "line",
      "source": "protomaps",
      "source-layer": "transit",
      "minzoom": 10,
      "filter": ["==", "pmap:kind", "rail"],
      "paint": {
        "line-color": "#c6bfb6",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.5, 15, 1.6]
      }
    },
    {
      "id": "roads-casing",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "minzoom": 6,
      "filter": ["in", "pmap:kind", "highway", "major_road", "medium_road", "minor_road"],
      "paint": {
        "line-color": [
          "match",
          ["get", "pmap:kind"],
          ["highway"], "#e0a96d",
          ["major_road"], "#dbc9a8",
          "#d6d0c8"
        ],
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          6, 1.5,
          10, 3.5,
          13, 7,
          15, 14
        ]
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "minzoom": 6,
      "filter": ["in", "pmap:kind", "highway", "major_road", "medium_road", "minor_road"],
      "paint": {
        "line-color": [
          "match",
          ["get", "pmap:kind"],
          ["highway"], "#fbcf8c",
          ["major_road"], "#fdf6e3",
          "#ffffff"
        ],
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          6, 0.6,
          10, 2,
          13, 5,
          15, 11
        ]
      }
    },
    {
      "id": "paths",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "minzoom": 14,
      "filter": ["==", "pmap:kind", "path"],
      "paint": {
        "line-color": "#cfc7bd",
        "line-width": ["interpolate", ["linear"], ["zoom"], 14, 0.6, 15, 1.4]
      }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "protomaps",
      "source-layer": "boundaries",
      "paint": {
        "line-color": "#9a93a8",
        "line-opacity": 0.6,
        "line-width": ["interpolate", ["linear"], ["zoom"], 4, 0.6, 12, 1.8]
      }
    },
    {
      "id": "road-labels",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "roads",
      "minzoom": 14,
      "filter": ["in", "pmap:kind", "highway", "major_road", "medium_road", "minor_road"],
      "layout": {
        "text-field": ["get", "name"],
        "symbol-placement": "line",
        "text-rotation-alignment": "viewport",
        "symbol-spacing": 250,
        "text-size": ["interpolate", ["linear"], ["zoom"], 14, 10, 15, 11]
      },
      "paint": {
        "text-color": "#6b6560",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "place-labels-neighbourhood",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "places",
      "minzoom": 13,
      "filter": ["==", "pmap:kind", "neighbourhood"],
      "layout": {
        "text-field": ["get", "name"],
        "text-size": 11
      },
      "paint": {
        "text-color": "#7a736c",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "place-labels-locality",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "places",
      "filter": ["==", "pmap:kind", "locality"],
      "layout": {
        "text-field": ["get", "name"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 6, 11, 12, 15, 15, 18]
      },
      "paint": {
        "text-color": "#3d3833",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.6
      }
    }
  ]
}
